{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LumenOSS/data-platform-blueprint/schema/catalogue.schema.json",
  "title": "Blueprint catalogue",
  "description": "The capabilities of the architecture and the contract clauses each must meet. The single source of IDs and clause text.",
  "type": "object",
  "required": ["version", "layers", "domains", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "SemVer of the blueprint. MAJOR when a clause changes meaning or a MUST is added; MINOR for new capabilities or SHOULD clauses; PATCH for wording.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^L[0-9]$" },
          "name": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "name": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "required": ["id", "name", "domain", "layer", "summary", "clauses"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CAP-[A-Z]+$" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "layer": { "type": "string", "pattern": "^L[0-9]$" },
        "summary": { "type": "string" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "pattern": "^CAP-[A-Z]+$" },
          "uniqueItems": true
        },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/clause" }
        }
      }
    },
    "clause": {
      "type": "object",
      "required": ["id", "level", "text", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CAP-[A-Z]+\\.[0-9]+$" },
        "level": { "enum": ["MUST", "SHOULD", "MAY"] },
        "text": { "type": "string" },
        "verify": {
          "description": "How an implementation shows it meets the clause: the test, query or inspection.",
          "type": "string"
        },
        "retired": {
          "description": "Set when the clause no longer applies. The ID is never reused.",
          "type": "string"
        }
      }
    }
  }
}
