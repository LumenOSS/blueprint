# Read by editors and by shfmt.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.sh]
# Google shell style: two spaces, binary operators may start a line.
indent_size = 2
binary_next_line = true
switch_case_indent = true

[justfile]
indent_size = 4
