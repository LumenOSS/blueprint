# Nix build outputs.
result
result-*
# Rendered diagrams are build output; the Mermaid source is the artefact.
build/
# Python caches from the check scripts.
__pycache__/
# Hugo writes a lock file while building.
site/.hugo_build.lock
# Favicons are rendered from the logo by `just site-icons`.
site/static/*.png
site/static/favicon.ico
# Hugo output and caches when run from site/.
site/public/
site/resources/
