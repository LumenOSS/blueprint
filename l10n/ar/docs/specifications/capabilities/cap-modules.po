msgid "CAP-MODULES Versioned modules"
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Shared building blocks consumed by immutable version, including deterministic naming."
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Layer L2 · domain: delivery"
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Purpose"
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Repositories share building blocks without sharing state or identity, and names are predictable."
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Why"
msgstr ""

#: docs/specifications/capabilities/cap-modules.md
msgid "Because names are deterministic, stacks can find each other without reading each other's state ([CAP-STATE.6]{1}). Because modules are pinned by tag, a change to a module only reaches a stack through that stack's own reviewed change."
msgstr ""

