msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "CAP-STORAGE.1"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "MUST"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Storage exposes an object API reached by identity, with encryption at rest."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Anonymous and shared-key access are refused."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "CAP-STORAGE.2"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Each domain catalog has its own storage location and credential, so a grant on one domain never reaches another's files."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "A credential for one domain cannot list another domain's location."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "CAP-STORAGE.3"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Protection against accidental deletion is configured in a way the table format supports; it never breaks table maintenance."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Maintenance (expiry, vacuum) runs clean, and a deleted table is restored in a drill."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "CAP-STORAGE.4"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Source-of-record files are kept in governed storage, tagged as real, with retention set by the data owner."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "The archive location carries provenance and retention metadata."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "CAP-STORAGE.5"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Object storage and the catalog are backed up on a declared cadence to a geographically separate location, and a scheduled drill restores from backup outside any migration."
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "The backup schedule is in code; the latest restore drill report compares content hashes and is within its schedule."
msgstr ""

