msgid "Contract"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Clause"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
msgid "Level"
msgstr ""

#: docs/specifications/capabilities/cap-storage.md
