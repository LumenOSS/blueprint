msgstr ""

#: docs/specifications/capabilities/README.md
msgid "Interfaces names what other capabilities and people use."
msgstr ""

#: docs/specifications/capabilities/README.md
msgid "Notes records the traps we found by running the architecture."
msgstr ""

#: docs/specifications/capabilities/README.md
msgid "Contract is the generated table of clauses."
msgstr ""

#: docs/specifications/capabilities/README.md
