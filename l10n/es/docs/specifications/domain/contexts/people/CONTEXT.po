msgid "People"
msgstr ""

#: docs/specifications/domain/contexts/people/CONTEXT.md
msgid "This context records who a person is, once, whatever roles they hold."
msgstr ""

#: docs/specifications/domain/contexts/people/CONTEXT.md
msgid "Language"
msgstr ""

#: docs/specifications/domain/contexts/people/CONTEXT.md
msgid "**Person**: A human being recorded once in the person registry, whatever roles they hold. _Avoid_: Individual, user, record"
msgstr ""

#: docs/specifications/domain/contexts/people/CONTEXT.md
msgid "**Organisation**: A body that is not a person, such as an agency, that can hold a role such as guardian. _Avoid_: Entity, party"
msgstr ""

#: docs/specifications/domain/contexts/people/CONTEXT.md
msgid "**External identifier**: An identifier issued by another authority and held as an attribute of a person or institution. _Avoid_: National ID as a key, reference number"
msgstr ""
